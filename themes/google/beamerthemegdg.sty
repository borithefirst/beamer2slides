% beamerthemegdg.sty -- the Google for Developers look of the public
% "GDG24 - PRO - Speaker Presentation Template" (Google Slides), rebuilt for beamer.
%
% Compile with LuaLaTeX, 16:9:  \documentclass[aspectratio=169]{beamer} \usetheme{gdg}
% Fonts: fonts/GoogleSansFlex-*.ttf and fonts/GoogleSansCode-*.ttf next to this file
% (open source, SIL OFL; fonts/build_fonts.py makes them).
%
% Theme options: accent=blue|red|yellow|green (default blue), sectionpages (a chapter
% slide at every \section).
% Layout vocabulary: see README.md next to this file.
%
% Geometry: every dimension is given in \gpt, one point of the 720 x 405 pt Google Slides
% page, so values can be read straight off the template (1 \gpt = 1/1.5875 bp).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemegdg}[2026/09/17 Google for Developers (GDG 2024) look]

\RequirePackage{iftex}
\ifluatex\else
  \PackageError{beamerthemegdg}{The gdg theme needs LuaLaTeX}{Compile with lualatex.}
\fi
\RequirePackage{fontspec}
\RequirePackage{tikz}
\RequirePackage{etoolbox}

\newdimen\gpt
\gpt=0.6299213bp

% ---------------------------------------------------------------- options
\def\gdg@accent{gblue}
\newif\ifgdg@sectionpages
\DeclareOptionBeamer{accent}{\def\gdg@accent{g#1}}
\DeclareOptionBeamer{sectionpages}[]{\gdg@sectionpagestrue}
\ProcessOptionsBeamer

\mode<presentation>

